RPC_URL=https://bsc-dataseed.binance.org
# 备选：https://bsc-rpc.publicnode.com 或专用的 QuickNode/Ankr 节点
DATABASE_URL=sqlite:///./monitor.db
# 用 Postgres：DATABASE_URL=postgresql+psycopg2://monitor:monitor@localhost:5432/monitor
POOLS=0xcc2bffaec373a6004bb6ccc8a62cdd66061f7c6a
WALLETS=0x42b5d65aa4dd8b4c896812a96c72f0cf89e5eae7
POLL_INTERVAL=20
WALLET_INTERVAL=120
STALE_AFTER=300
CONFIRMATIONS=15
LOG_CHUNK=2000
SWAP_LOOKBACK_BLOCKS=120000
POSITION_LOOKBACK_BLOCKS=400000
RPC_MIN_INTERVAL=0.05
# @BotFather 创建 bot 得到的 token；留空则关闭 Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_SEND_INTERVAL=1.1
TELEGRAM_MAX_RETRY=5
# 管理接口鉴权
ADMIN_API_KEY=change-me
